NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
DATABASE_URL_DIRECT=postgres://user:password@host:port/database?sslmode=require
DATABASE_CA_PATH=/absolute/path/to/ca.pem

SESSION_SECRET=replace-with-32-byte-random-hex
API_KEY_PEPPER=replace-with-32-byte-random-hex

BANKAI_BASE_URL=https://bankai.web.id/api
BANKAI_API_KEY=sk-bankai-replace-me
BANKAI_CHAT_PATH=/chat/completions
BANKAI_MODELS_PATH=/v1/models
BANKAI_QUOTA_PATH=/v1/quota
BANKAI_AUTH_HEADER=authorization
BANKAI_AUTH_SCHEME=Bearer
BANKAI_STREAM_USAGE=true
BANKAI_TIMEOUT_MS=120000
BANKAI_STREAM_TIMEOUT_MS=300000

BILLING_ENABLED=false
BILLING_UPSTREAM_PARITY_VERIFIED=false
BILLING_RESERVATION_TTL_MS=600000
BILLING_MAX_RESERVE=1000000
REGISTRATION_MODE=closed

# ============================================================
# Midtrans QRIS
# Sandbox: https://api.sandbox.midtrans.com
# Production: https://api.midtrans.com
# ============================================================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

ADMIN_EMAIL=admin@rexu.local
ADMIN_PASSWORD=

LOG_LEVEL=info
TRUST_PROXY=false
# Origin tambahan yang diizinkan untuk request /api/* (pisahkan dengan koma).
# Contoh: http://10.0.0.5:21072,https://rexu.example.com
TRUSTED_ORIGINS=

# ============================================================
# Telegram Monitor (opsional)
# Kosongkan TELEGRAM_BOT_TOKEN/CHAT_ID untuk menonaktifkan monitor.
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional, untuk forum group/supergroup.
TELEGRAM_THREAD_ID=

# Monitor intervals (ms)
MONITOR_QUOTA_INTERVAL_MS=900000
MONITOR_UPSTREAM_INTERVAL_MS=1800000
MONITOR_RECONCILE_INTERVAL_MS=3600000

# Monitor thresholds
MONITOR_QUOTA_WARN_PCT=80
MONITOR_QUOTA_CRITICAL_PCT=90
MONITOR_RECONCILE_PENDING_HOURS=6
